# Is file ko copy karke keys.env naam do, aur apni keys bharo. keys.env kabhi kisi ko mat bhejna.
# Copy this file to keys.env and fill in your own keys. Never share keys.env.

# Zaroori / required: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: backup dimaag + Whisper se sunna / backup brain + voice transcription: https://console.groq.com/keys
GROQ_API_KEY=

# Optional: phone link. Telegram pe @BotFather se apna bot banao / create your own bot with @BotFather
TELEGRAM_BOT_TOKEN=

# Optional: sirf tab jab config.py me BRAIN = "claude" ho / only if BRAIN = "claude": https://console.anthropic.com
ANTHROPIC_API_KEY=
